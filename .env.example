NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=
MONGO_DB_NAME=neuro_data_platform

# Redis — must be the same instance Python's redis_publisher.py uses
REDIS_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d



# CORS — your frontend's real origin, no wildcard in production
FRONTEND_ORIGIN=https://neuro-frontend-two.vercel.app


# Python agent service
PYTHON_AGENT_BASE_URL=https://dataset-agents.vercel.app/api/v1/
PYTHON_AGENT_INTERNAL_SECRET=
PYTHON_AGENT_TIMEOUT_MS=65000

# Email-to-ticket webhook. Generate a long random value and configure the
# provider to send it in X-Ticket-Ingest-Secret.
TICKET_INGEST_SECRET=

# Admin bootstrap (used only by scripts/seedAdmin.js)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Google Sign-In — fill in once available
# GOOGLE_CLIENT_ID=

# Gmail SMTP (Nodemailer) — use an App Password, not your Google account password
SMTP_USER=
SMTP_PASS=

# OTP expiry (minutes)
OTP_EXPIRY_MINUTES=10
ADMIN_OTP_EXPIRY_MINUTES=5
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
